# mylinks.bar — Apache settings for Beget (Vite copies this file into dist)
Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/svg+xml .svg
AddType font/woff2 .woff2

<IfModule mod_setenvif.c>
  SetEnvIfNoCase Authorization "^(.+)$" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.well-known/acme-challenge/ - [L]
  # Beget terminates TLS at its proxy before forwarding to Apache.
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]
  # Static folders: real files or a real 404, never the app page
  RewriteRule ^(?:assets|icons|sounds|fonts|admin)/ - [L]
  # Preview images are PNGs served directly on this domain, without redirects.
  RewriteRule ^share-image/([a-z0-9][a-z0-9._-]{1,28}[a-z0-9])\.[a-f0-9]{12}\.png$ share-image.php?handle=$1 [L]
  RewriteRule ^avatar/([a-z0-9][a-z0-9._-]{1,28}[a-z0-9])/([a-f0-9]{8})-(560|1000)(-poster)?\.(webp|mp4)$ avatar-asset.php?handle=$1&hash=$2&size=$3&poster=$4&extension=$5 [L]
  # A new namespace escapes previously cached SPA HTML under image URLs.
  RewriteRule ^i/v2/([a-z0-9][a-z0-9._-]{1,28}[a-z0-9])/([a-f0-9-]{36})/([a-f0-9]{12})\.png$ link-icon.php?handle=$1&id=$2&hash=$3 [END]
  RewriteRule ^link-icon/([a-z0-9][a-z0-9._-]{1,28}[a-z0-9])/([a-f0-9-]{36})/([a-f0-9]{12})\.png$ /i/v2/$1/$2/$3.png [R=301,END,NE]
  RewriteRule ^link-icon/([a-f0-9-]{36})/([a-f0-9]{12})\.png$ legacy-icon.php?id=$1&hash=$2 [END]
  # Malformed service URLs are errors, never routes in the SPA.
  RewriteRule ^(?:i|link-icon|avatar|share-image)(?:/|$) asset-not-found.php [END]
  RewriteRule ^(?:profile-image|profile-image-process|avatar-asset|link-icon|site-icon|legacy-icon)\.php/ asset-not-found.php [END]
  RewriteRule ^\.private-assets(?:/|$) - [F,END]
  # Metadata must be present for every visitor, regardless of crawler User-Agent.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9][a-z0-9._-]{1,28}[a-z0-9])/?$ share-profile.php?handle=$1 [L]
  # Single-page app: any other path that is not a real file opens index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

ErrorDocument 404 /asset-not-found.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # The page itself is always revalidated, so updates appear immediately
  <FilesMatch "(?:\.html$|^share-profile\.php$)">
    FileETag None
    RequestHeader unset If-None-Match
    RequestHeader unset If-Modified-Since
    Header unset ETag
    Header always unset ETag
    Header unset Last-Modified
    Header always unset Last-Modified
    Header unset Cache-Control
    Header always set Cache-Control "no-store"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/fonts/.*\.woff2$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Build files in /assets have a content hash in the name: cache for a year
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

